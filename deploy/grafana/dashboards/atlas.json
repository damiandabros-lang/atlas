{
  "uid": "atlas-overview",
  "title": "ATLAS \u2014 Network Service Orchestration",
  "description": "Workflow throughput/failures/latency, device operations and reconciliation drift for the ATLAS platform.",
  "tags": [
    "atlas",
    "temporal",
    "orchestration",
    "l3vpn"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "workflow_type",
        "label": "Workflow type",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "atlas-prometheus"
        },
        "query": {
          "query": "label_values(atlas_workflow_total, workflow_type)",
          "refId": "wf"
        },
        "definition": "label_values(atlas_workflow_total, workflow_type)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "atlas-prometheus"
        },
        "enable": true,
        "name": "Workflow failures",
        "iconColor": "red",
        "expr": "changes(atlas_workflow_failures_total[1m]) > 0",
        "step": "1m",
        "titleFormat": "Workflow failed",
        "textFormat": "{{workflow_type}}"
      }
    ]
  },
  "links": [
    {
      "title": "Temporal UI",
      "type": "link",
      "url": "http://localhost:8080",
      "targetBlank": true,
      "icon": "external link"
    },
    {
      "title": "API docs",
      "type": "link",
      "url": "http://localhost:8000/docs",
      "targetBlank": true,
      "icon": "doc"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Workflows",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Workflows started (1h)",
      "description": "Total workflow executions started across all types in the last hour.",
      "datasource": {
        "type": "prometheus",
        "uid": "atlas-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "atlas-prometheus"
          },
          "expr": "sum(increase(atlas_workflow_total{workflow_type=~\"$workflow_type\"}[1h]))",
          "legendFormat": "started",
          "refId": "A",
          "range": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
