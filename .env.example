# ---------------------------------------------------------------------------
# ATLAS — environment configuration
#
# Copy to `.env` (git-ignored). Every setting in atlas/core/config.py is
# overridable with an ATLAS_-prefixed variable. docker-compose.yml also reads
# this file for host port mappings and the image tag.
# ---------------------------------------------------------------------------

# --- Application -------------------------------------------------------------
ATLAS_APP_NAME=atlas
ATLAS_ENVIRONMENT=dev                 # dev | staging | prod — emitted in logs/metrics
ATLAS_LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
ATLAS_LOG_JSON=true                   # structured JSON logs (false => coloured console for local dev)

# --- REST API ----------------------------------------------------------------
ATLAS_API_HOST=0.0.0.0
ATLAS_API_PORT=8000
# JSON list of static operator API keys (MVP auth; swap for OIDC/JWT in production).
# Clients send:  X-API-Key: dev-operator-key
ATLAS_API_KEYS=["dev-operator-key"]
# How long an Idempotency-Key is remembered for POST/DELETE replay protection.
ATLAS_IDEMPOTENCY_TTL_SECONDS=86400

# --- PostgreSQL (business/service state) ------------------------------------
# Inside docker compose the api/worker override this with the `postgres` hostname.
ATLAS_DATABASE_URL=postgresql+asyncpg://atlas:atlas@localhost:5432/atlas
ATLAS_DB_ECHO=false
ATLAS_DB_POOL_SIZE=10

# --- Temporal (durable workflow execution state) -----------------------------
ATLAS_TEMPORAL_HOST=localhost:7233
ATLAS_TEMPORAL_NAMESPACE=default
ATLAS_TEMPORAL_TASK_QUEUE=atlas-orchestration
ATLAS_TEMPORAL_TLS=false

# --- Network adapters ----------------------------------------------------------
ATLAS_ADAPTER_BACKEND=mock            # mock | iosxr | junos  (per-device vendor comes from inventory)
# Failure injection for MockNetworkAdapter (worker side). One of:
#   NONE | FAIL_ON_PE3 | TIMEOUT_ON_PE2 | BGP_SESSION_DOWN | DEVICE_UNREACHABLE | PARTIAL_CONFIGURATION
ATLAS_MOCK_FAILURE_MODE=NONE
ATLAS_MOCK_LATENCY_MS=50
# Where device credentials are resolved from: env | k8s-secret | vault
ATLAS_DEVICE_CREDENTIALS_REF=env
ATLAS_DEVICE_USERNAME=atlas
ATLAS_DEVICE_PASSWORD=                # never commit a real value; use a secret manager

# --- Resource pools (RD/RT/VLAN/PE-CE addressing) ------------------------------
ATLAS_BGP_ASN=65000
ATLAS_RD_POOL_START=1000
ATLAS_RD_POOL_END=1999
ATLAS_RT_POOL_START=100
ATLAS_RT_POOL_END=999
ATLAS_VLAN_POOL_START=100
ATLAS_VLAN_POOL_END=4000
ATLAS_PE_CE_SUPERNET=10.255.0.0/16    # /30 links are carved from this block

# --- Reconciliation ----------------------------------------------------------
ATLAS_RECONCILIATION_MODE=DETECT_ONLY # DETECT_ONLY | AUTO_REMEDIATE (not enabled in MVP)

# --- Observability -----------------------------------------------------------
ATLAS_METRICS_ENABLED=true
ATLAS_OTEL_ENABLED=false              # set true and start `docker compose --profile tracing`
ATLAS_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
ATLAS_OTEL_SERVICE_NAME=atlas

# --- Container entrypoint (deploy/docker/entrypoint.sh) ------------------------
ATLAS_RUN_MIGRATIONS=0                # 1 => `alembic upgrade head` before start
ATLAS_SEED=0                          # 1 => `atlas-seed` (idempotent demo inventory: PE1..PE3, ACME)
ATLAS_WAIT_FOR_DB=1
ATLAS_WAIT_FOR_TEMPORAL=1

# --- docker-compose host-side knobs (not read by the application) --------------
ATLAS_IMAGE=ghcr.io/damiandabros-lang/atlas:dev
ATLAS_POSTGRES_PORT=5432
ATLAS_TEMPORAL_PORT=7233
ATLAS_TEMPORAL_UI_PORT=8080
ATLAS_WORKER_METRICS_PORT=9090
ATLAS_PROMETHEUS_PORT=9091
ATLAS_GRAFANA_PORT=3000
ATLAS_JAEGER_PORT=16686
